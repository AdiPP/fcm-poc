# Firebase web app config (Project settings > Your apps > Web app > SDK setup). Not secret.
VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=...
VITE_FIREBASE_PROJECT_ID=...
VITE_FIREBASE_STORAGE_BUCKET=...
VITE_FIREBASE_MESSAGING_SENDER_ID=...
VITE_FIREBASE_APP_ID=...
# Web Push certificate key pair (Project settings > Cloud Messaging > Web configuration).
VITE_VAPID_KEY=...
# Same value as the server's DEV_SECRET (baked into the bundle — POC only).
VITE_DEV_SECRET=change-me
