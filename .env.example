# Reference copy — real values live in server/.env and web/.env (copied from each dir's .env.example).

# --- server/ ---
# Path to the Firebase service account JSON (Project settings > Service accounts > Generate new key).
# Relative to the server/ working directory.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccount.json
# Shared secret required in the X-Dev-Secret header on /send and /subscribe. Any string.
DEV_SECRET=change-me
PORT=3000

# --- web/ ---
# Firebase web app config (Project settings > Your apps > Web app > SDK setup). Not secret.
VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=...
VITE_FIREBASE_PROJECT_ID=...
VITE_FIREBASE_STORAGE_BUCKET=...
VITE_FIREBASE_MESSAGING_SENDER_ID=...
VITE_FIREBASE_APP_ID=...
# Web Push certificate key pair (Project settings > Cloud Messaging > Web configuration > Generate key pair).
VITE_VAPID_KEY=...
# Same value as server DEV_SECRET (baked into the client bundle — POC only).
VITE_DEV_SECRET=change-me
